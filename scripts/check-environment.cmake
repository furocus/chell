cmake_minimum_required(VERSION 3.27)
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Use native Windows, not WSL or a Linux container.")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../config/toolchain.json" cshell_lock)
foreach(key IN ITEMS msvc windowsSdk cmake ninja architecture)
  string(JSON cshell_${key} GET "${cshell_lock}" "${key}")
endforeach()
if(NOT "$ENV{VCToolsVersion}" STREQUAL "${cshell_msvc}")
  message(FATAL_ERROR "MSVC mismatch: need ${cshell_msvc}, got '$ENV{VCToolsVersion}'. Use scripts/dev.cmd.")
endif()
string(REGEX REPLACE "[/\\]+$" "" cshell_actual_sdk "$ENV{WindowsSDKVersion}")
if(NOT cshell_actual_sdk STREQUAL cshell_windowsSdk)
  message(FATAL_ERROR "SDK mismatch: need ${cshell_windowsSdk}, got '${cshell_actual_sdk}'.")
endif()
if(NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "${cshell_architecture}")
  message(FATAL_ERROR "An x64 MSVC developer environment is required.")
endif()
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" cshell_actual_cmake "${CMAKE_VERSION}")
if(NOT cshell_actual_cmake STREQUAL cshell_cmake)
  message(FATAL_ERROR "CMake mismatch: need ${cshell_cmake}, got ${CMAKE_VERSION}.")
endif()
find_program(cshell_ninja_program NAMES ninja REQUIRED)
execute_process(COMMAND "${cshell_ninja_program}" --version
  RESULT_VARIABLE cshell_ninja_status OUTPUT_VARIABLE cshell_actual_ninja
  ERROR_VARIABLE cshell_ninja_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT cshell_ninja_status EQUAL 0 OR NOT cshell_actual_ninja STREQUAL cshell_ninja)
  message(FATAL_ERROR "Ninja mismatch: need ${cshell_ninja}, got '${cshell_actual_ninja}'. ${cshell_ninja_error}")
endif()
find_program(cshell_cl_program NAMES cl REQUIRED)
message(STATUS "Environment OK: MSVC ${cshell_msvc}; SDK ${cshell_windowsSdk}; x64; CMake ${CMAKE_VERSION}; Ninja ${cshell_ninja}")
